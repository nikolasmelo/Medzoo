"appropriate": true,
"description": "Oferecer papa de frutas aquecida via seringa esofágica e suplementar com Ringer Lactato SC.",
"id": "assisted_feeding",
"name": "Alimentação assistida por sonda e fluidoterapia SC"
}, {
"appropriate": true,
"description": "Administrar Meloxicam 0.5mg/kg IM para controle da inflamação e analgesia.",
"id": "analgesia",
"name": "Analgesia com Meloxicam IM (0.5mg/kg)"
}, {
"appropriate": true,
"description": "Manter em recinto aquecido com poleiro largo e oferta de frutas macias picadas.",
"id": "supportive_care",
"name": "Recinto terapêutico com dieta pastosa"
}, {
"appropriate": false,
"description": "Cortar a porção danificada do bico com alicate cirúrgico (a ramfoteca possui vascularização interna e inervação — corte indiscriminado causa hemorragia e dor extrema).",
"id": "beak_trimming_aggressive",
"name": "Aparar ramfoteca com alicate cirúrgico"
}, {
"appropriate": false,
"description": "Usar adesivo cianoacrilato (Super Bonder) para colar a fissura (libera calor exotérmico e vapores tóxicos para tecido vivo).",
"id": "cyanoacrylate_glue",
"name": "Colagem da fissura com cianoacrilato comercial"
}, {
"appropriate": false,
"description": "Forçar alimentação de ração para papagaios seca e dura pelo bico fraturado (causa dor intensa e agrava a fissura).",
"id": "hard_food_forcing",
"name": "Oferecer ração granulada seca via bico fraturado"
}])
