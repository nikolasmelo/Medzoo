	"appropriate": true,
	"description": "Instalar O2 umidificado via máscara ou câmara a 40-60% com nebulização de solução salina.",
	"id": "oxygen_therapy",
	"name": "Oxigenoterapia umidificada e nebulização salina"
}, {
	"appropriate": true,
	"description": "Lavar queimaduras com soro fisiológico morno e aplicar curativos com sulfadiazina de prata 1%.",
	"id": "burn_dressing",
	"name": "Curativos com sulfadiazina de prata 1% nas patas"
}, {
	"appropriate": true,
	"description": "Tramadol 5mg/kg IM para analgesia e Ringer Lactato aquecido IV/SC para reposição volêmica.",
	"id": "analgesia_fluids",
	"name": "Analgesia opioide (Tramadol) e fluidoterapia aquecida"
}, {
	"appropriate": true,
	"description": "Acomodar em recinto aquecido (ZPOT 28°C) com substrato antiderrapante macio e monitorar FR.",
	"id": "warm_enclosure",
	"name": "Recinto aquecido com monitoramento respiratório contínuo"
}, {
	"appropriate": false,
	"description": "Aplicar gelo direto sobre as queimaduras de segundo grau (provoca vasoconstrição e agrava necrose tecidual em queimaduras).",
	"id": "ice_on_burns",
	"name": "Crioterapia direta sobre queimaduras de 2º grau"
}, {
	"appropriate": false,
	"description": "Administrar Dexametasona IV como anti-inflamatório (em queimados suprime resposta imune e eleva risco de sepse).",
	"id": "dexamethasone_burn",
	"name": "Corticoterapia sistêmica (Dexametasona IV)"
}, {
	"appropriate": false,
	"description": "Desbridar mecanicamente as bolhas e esfregar solução de iodo concentrado (citotóxica para tecido de granulação).",
	"id": "iodine_scrub_burns",
	"name": "Desbridamento agressivo com iodopovidona concentrada"
}])
