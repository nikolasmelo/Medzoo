initial_behavior = "Em tanques de contenção aquática, taquipneico no espiráculo, buscando boiar em decúbito lateral."
physical_exam_notes = "Fios de nylon estrangulando o pedúnculo caudal, celulite exsudativa e dor à palpação local."
