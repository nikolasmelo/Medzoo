educational_notes = {
"why_hypothesis": "A desidratação agrava o choque traumático. O ultrassom Fast/FAST-VET é essencial para avaliar a integridade dos órgãos internos e afastar celomite ou hemorragia interna.",
"why_ultrasound": "A Ultrassonografia Celomática permite visualizar tecidos moles e órgãos internos sob a carapaça rígida, confirmando a ausência de efusão ou rupturas passionais."
