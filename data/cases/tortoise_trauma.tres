physical_description = "Réptil quelônio de médio porte. Apresenta fissura e sensibilidade na parte ventral do casco (plastrão) e mucosas desidratadas."
initial_behavior = "Recolhido dentro do casco, apático, com movimentos lentos e estresse moderado devido ao manuseio prévio."
physical_exam_notes = "Fissura visível com reação dolorosa à palpação na região ventral (plastrão) e sinais cutâneos de desidratação."
initial_evidence_ids = Array[String](["plastron_trauma_visible"])
recovery_notes = "Excelente recuperação (limpeza e estabilização do plastrão concluídas, hidratação restabelecida e boa aceitação alimentar no recinto de reabilitação)."
