treatment_options = Array[Dictionary]([{
"appropriate": true,
"description": "Realizar desinfecção cuidadosa com clorexidina diluída, alinhamento e estabilização de fenda com resina e fios de pontes.",
"id": "plastron_fixation",
"name": "Assepsia, alinhamento e estabilização de plastrão"
}, {
"appropriate": true,
"description": "Administrar solução de Ringer Lactato aquecida (ZPOT 30°C) via intracelomática/intracoelomic.",
"id": "fluid_therapy",
"name": "Fluidoterapia de reidratação intracoelômica aquecida"
}, {
"appropriate": true,
"description": "Prescrever Tramadol e Ceftazidima para profilaxia de infecção óssea e celomite.",
"id": "analgesia_antibiotic",
"name": "Analgesia e cobertura antibiótica (Ceftazidima)"
}, {
"appropriate": true,
"description": "Acomodar em recinto mantido na Zona Preferencial Ótima de Temperatura (ZPOT 28-32°C).",
"id": "warm_habitat",
"name": "Manutenção na ZPOT (28-32°C) com suporte térmico"
}, {
"appropriate": false,
"description": "Selar a fenda com resina epóxi direta sobre o osso sujo sem desbridamento (retém bactérias na cavidade celomática provocando celomite).",
"id": "epoxy_without_debridement",
"name": "Selamento com resina epóxi sobre ferida não desbridada"
}, {
"appropriate": false,
"description": "Injetar grande volume de soro frio diretamente no celoma de réptil ectotérmico (induz hipotermia severa e colapso metabólico).",
"id": "cold_fluid_bolus",
"name": "Fluidoterapia em bolus frio não aquecido"
}, {
"appropriate": false,
"description": "Administrar Gentamicina em alta dose em réptil desidratado (alto risco de necrose tubular renal aguda).",
"id": "aminoglycoside_nephrotoxic",
"name": "Gentamicina sistêmica em alta dose sem hidratação prévia"
}])
