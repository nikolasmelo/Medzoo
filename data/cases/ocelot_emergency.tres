	"xray_tfast": {
		"description": "Exame Radiográfico e TFAST de emergência para diagnosticar pneumotórax hipertensivo.",
		"evidence_id": "xray_pneumothorax_severe",
		"name": "Raio-X e Ultrassom TFAST Torácico",
		"required_evidence_id": "silent_right_lung"
	}
}
correct_diagnosis = "Pneumotórax hipertensivo por ferimento perfurante"
possible_diagnoses = Array[String](["Pneumotórax hipertensivo por ferimento perfurante", "Peritonite infecciosa felina (PIF)", "Fratura de bacia descompensada", "Hérnia diafragmática congênita"])
hypothesis_evidence_map = {
	"Fratura de bacia descompensada": Array[String](["thoracic_wound_visible"]),
