}
treatment_options = Array[Dictionary]([{
	"appropriate": true,
	"description": "Toracocentese imediata com agulha 16G no 2º espaço intercostal seguida de dreno selo d'água.",
	"id": "thoracocentesis",
	"name": "Toracocentese descompressiva e dreno torácico"
}, {
	"appropriate": true,
	"description": "Oxigênio 100% via máscara ou câmara sob supervisão contínua do padrão respiratório.",
	"id": "o2_high_flow",
	"name": "Oxigenoterapia de alto fluxo (FiO2 100%)"
}, {
	"appropriate": true,
	"description": "Butorfanol 0.2mg/kg IM para sedação analgésica leve sem depressão respiratória significativa.",
	"id": "sedation_analgesia",
	"name": "Analgesia com Butorfanol (0.2mg/kg IM)"
}, {
	"appropriate": true,
	"description": "Ocluir o ferimento com curativo valvulado de três pontas para impedir nova entrada de ar.",
	"id": "occlusive_dressing",
	"name": "Curativo oclusivo valvulado de 3 pontas"
}, {
	"appropriate": false,
	"description": "Ventilar com pressão positiva antes de drenar o pneumotórax (aumenta a pressão intratorácica e causa colapso cardiovascular).",
	"id": "ppv_before_drain",
	"name": "Ventilação com pressão positiva sem drenagem prévia"
}, {
	"appropriate": false,
	"description": "Administrar Quetamina como anestesia geral (deprime reflexos respiratórios em animal já em insuficiência ventilatória).",
	"id": "ketamine_respiratory",
	"name": "Anestesia geral com Quetamina IV"
}, {
	"appropriate": false,
	"description": "Selar hermeticamente o ferimento com curativo totalmente oclusivo (transforma pneumotórax aberto em hipertensivo fechado).",
	"id": "full_seal_wound",
	"name": "Curativo 100% oclusivo selando a ferida por completo"
}])
clinical_problems = Array[Dictionary]([{
	"description": "Acúmulo de ar sob pressão no espaço pleural causando colapso pulmonar e insuficiência respiratória iminente.",
	"id": "pneumothorax",
	"name": "Pneumotórax Hipertensivo Emergencial"
}])
differential_diagnoses = Array[Dictionary]([{
	"conflicting_evidence": [],
	"description": "Colapso pulmonar por ar sob pressão na cavidade pleural secundário a trauma penetrante.",
	"id": "pneumothorax_case",
	"name": "Pneumotórax hipertensivo por ferimento perfurante",
	"supporting_evidence": ["thoracic_wound_visible", "cyanosis_dyspnea", "silent_right_lung", "xray_pneumothorax_severe"],
	"useful_exams": ["xray_tfast"]
}])
educational_notes = {
	"why_hypothesis": "O pneumotórax hipertensivo é uma emergência médica absoluta em felídeos selvagens. A descompressão com agulha (toracocentese) salva a vida do animal em poucos segundos."
}
