xray_hotspot_radius = 70.0
career_order = 6
required_stars = 5
minimum_rank = 4
reputation_reward = 1000
difficulty = 5
shift_priority = 2
image_texture = ExtResource("2_ocelot_img")

evidence_data = {
	"cyanosis_dyspnea": {
		"text": "Mucosas cianóticas (violáceas), respiração com padrão abdominal severo e enfisema subcutâneo no pescoço/tórax."
	},
	"silent_right_lung": {
		"text": "Ausculta pulmonar com abafamento completo de ruídos respiratórios no hemitórax direito."
	},
	"thoracic_wound_visible": {
		"text": "Ferimento penetrante na caixa torácica direita entre o 6º e 7º espaço intercostal."
	},
	"xray_pneumothorax_severe": {
		"text": "Radiografia e Ultrassom TFAST confirmam pneumotórax hipertensivo à direita com atelectasia e desvio mediastinal."
