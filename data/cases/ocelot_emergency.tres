arrival_reason = "Jaguatirica fêmea resgatada com ferimento torácico perfurante por arame farpado. Apresenta dispneia grave, respiração abdominal e cianose."
physical_description = "Felídeo silvestre de pelagem pintada deslumbrante. Perfuração torácica à direita com enfisema subcutâneo palpável."
initial_behavior = "Cianótica, extremamente estressada, buscando ar com a boca aberta e taquipneica."
physical_exam_notes = "Perfuração intercostal à direita com murmúrio vesicular abafado/ausente e turgor alterado."
initial_evidence_ids = Array[String](["thoracic_wound_visible"])
recovery_notes = "Recuperação excepcional (toracocentese de alívio e drenagem torácica cirúrgica realizadas pela equipe sênior com plena reexpansão pulmonar)."
initial_stress = 50.0
stress_rate_per_exam = 20.0
case_budget = 900.0
exam_cost = 150.0
