}
treatment_options = Array[Dictionary]([{
	"appropriate": true,
	"description": "Administrar quelante Ca-EDTA (35mg/kg IM) a cada 12h para remoção do chumbo da corrente sanguínea.",
	"id": "chelation_edta",
	"name": "Quelação com Ca-EDTA parenteral (35mg/kg)"
}, {
	"appropriate": true,
	"description": "Realizar lavagem do papo assistida com solução salina morna e óleo mineral para remoção de resíduos.",
	"id": "crop_lavage",
	"name": "Lavagem inglúvia e remoção de resíduos do papo"
}, {
	"appropriate": true,
	"description": "Fluidoterapia de suporte com Ringer Lactato SC e aquecimento a 29°C.",
	"id": "fluid_warm_support",
	"name": "Fluidoterapia aquecida e suporte em UTIP aviária"
}, {
	"appropriate": true,
	"description": "Prescrever Complexo B e Cálcio Gluconato para proteção neurológica.",
	"id": "neuro_protection",
	"name": "Suplementação neurológica (Complexo B e Cálcio)"
}, {
	"appropriate": false,
	"description": "Forçar sulfato de bário via oral sem desobstruir o papo (provoca broncoaspiração e piora a estase).",
	"id": "barium_forcing",
	"name": "Administração forçada de sulfato de bário por via oral"
}, {
	"appropriate": false,
	"description": "Aplicar penicilina concentrada pura via oral (provoca necrose de mucosa e disbiose grave em psitacídeos).",
	"id": "oral_penicillin_pure",
	"name": "Penicilina concentrada por via oral"
}, {
	"appropriate": false,
	"description": "Manter a arara sob ar condicionado gelado a 18°C (induz hipotermia severa e colapso circulatório).",
	"id": "cold_air_exposure",
	"name": "Recinto frio sob ar condicionado"
}])
