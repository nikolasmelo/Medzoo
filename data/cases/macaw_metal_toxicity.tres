evidence_data = {
	"crop_stasis_pain": {
		"text": "Palpação do papo demonstra distensão, sensibilidade dolorosa e retenção de conteúdo alimentar desidratado."
	},
	"wing_tremor_drooping": {
		"text": "Tremores finos de extremidades e incapacidade de sustentar a postura em poleiro."
	},
	"xray_foreign_metal_body": {
		"text": "Radiografia evidencia fragmento metálico radio-opaco de alta densidade retido no papo/proventrículo."
	}
}
