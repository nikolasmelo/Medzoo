}])
educational_notes = {
	"why_hypothesis": "A intoxicação por metais pesados (chumbo/zinco) é uma emergência comum em psitacídeos mantidos em malhas galvanizadas. A quelação com Ca-EDTA deve ser iniciada precocemente."
