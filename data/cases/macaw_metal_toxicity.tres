[gd_resource type="Resource" script_class="CaseData" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/resources/case_data.gd" id="1_casedata"]
[ext_resource type="Texture2D" path="res://assets/macaw_patient.jpg" id="2_macaw_img"]

[resource]
script = ExtResource("1_casedata")
case_id = "macaw_01"
species_name = "Arara-azul-grande"
scientific_name = "Anodorhynchus hyacinthinus"
patient_code = "PAC-2026-008"
arrival_reason = "Arara-azul resgatada de cativeiro irregular. Apresenta fraqueza muscular nas pernas, tremores de asas, inapetência e estase inglúvia."
physical_description = "Ave psitaciforme de grande porte com plumagem azul intensa. Prostrada, com asas descaídas e paresia leve em membros posteriores."
initial_behavior = "Em decúbito no recinto, sonolenta, com pouca reatividade a estímulos externos e tremores finos nas extremidades."
physical_exam_notes = "Estase do papo (inglúvio) com resíduos estagnados, fraqueza à palpação de gavras e mucosas orais pálidas."
initial_evidence_ids = Array[String](["wing_tremor_drooping"])
recovery_notes = "Excelente recuperação (desintoxicação por Ca-EDTA concluída, esvaziamento e lavagem do papo bem-sucedidos e retorno da mobilidade)."
initial_stress = 30.0
stress_rate_per_exam = 12.0
case_budget = 550.0
exam_cost = 100.0
xray_hotspot = Vector2(260, 200)
xray_hotspot_radius = 60.0
career_order = 7
required_stars = 3
minimum_rank = 1
reputation_reward = 500
difficulty = 2
shift_priority = 1

